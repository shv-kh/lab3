`timescale 1ns/1ps

import alu_common::*;

module alu (
    input logic [7:0] a,
    input logic [7:0] b,
    input alu_op_t fn,
    output logic [7:0] result,
    output logic overflow,
    output logic sign
    );
    
    logic [9:0] signed_b, signed_a, result_ext; 
    
    always_comb begin
        overflow = 1'b0;
        signed_a = 10'b0;
        signed_b = 10'b0;
        result_ext = 10'b0;
        result = 8'b0;
        sign = 1'b0;
    
        case (fn)
            INPUT_A: begin
                result = a;
            end
            INPUT_B: begin
                result = b;
            end
            U_ADD: begin
                result = a + b;
                overflow = (result < a); 
                sign = 1'b0;
            end
            
            U_SUB: begin
                signed_a = {2'b0,a};
                signed_b = (~{2'b0,b}) + 10'd1;
                result_ext = signed_a + signed_b; 
                result = result_ext[7:0];
                if (result_ext[7] == 1) begin
                    sign = 1'b1;
                    result = ~result + 8'd1;
                end else begin
                    sign = 1'b0;
                end
            end
            
            U_MOD3: begin
                result = a - 3*(a/3);
                sign = 1'b0;
            end
            
            S_ADD: begin
                result = a + b;
                overflow = (a[7] != result[7] && b[7] != result[7]);
                if (result[7] == 1) begin
                    result = ~result + 10'd1;
                    sign = 1'b1;
                end else begin
                    sign = 1'b0;
                end
            end
            S_SUB: begin
                 signed_b = ~{{2{b[7]}},b} + 10'd1;
                 signed_a = {{2{a[7]}},a};
                 result_ext = signed_a + signed_b;
                 overflow = (result_ext[8]);
                 if (result_ext[7] == 1) begin
                    sign = 1'b1;
                    result_ext = (~result_ext + 10'd1);  
                    result = result_ext[7:0];
                    overflow = (result_ext[8]);
                 end else begin
                    sign = 1'b0;
                    result = result_ext[7:0];
                 end
            end
            S_MOD3: begin
                if (a[7]==0) begin
                    result = a - 3*(a/3);
                end else begin
                    signed_a = {2'b0,~{a}} + 10'd1;
                    result_ext = 8'(signed_a - 3*(signed_a/3));
                    if (result_ext == 0) begin
                        result = 0;
                    end else begin
                        result = 3 - result_ext;
                    end
                end
            end
            
        endcase
        
    end
